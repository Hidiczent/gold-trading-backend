{
  "info": {
    "name": "Gold Trading API v1",
    "description": "Import คู่กับ environment `Gold Trading — Local`.\n\nลำดับทดสอบ:\n1. Health\n2. Auth → Login User (เก็บ token อัตโนมัติ)\n3. Wallet → Deposit\n4. Gold Price → Get\n5. Trades → Buy\n6. Gold Holdings → Get\n7. Trades → Sell\n8. Transactions / Trades list\n9. Login Admin → Admin endpoints\n\nSeed: user@example.com / User123! , admin@example.com / Admin123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('token', j.data.token);",
                  "  pm.environment.set('userId', j.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login User (seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('token', j.data.token);",
                  "  pm.environment.set('userId', j.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Admin (seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('adminToken', pm.response.json().data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "GET wallet balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/wallet"
          }
        },
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10000000\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/wallet/deposit"
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"500000\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/wallet/withdraw"
          }
        }
      ]
    },
    {
      "name": "Gold Price",
      "item": [
        {
          "name": "GET gold price",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/gold-price"
          }
        }
      ]
    },
    {
      "name": "Gold Holdings",
      "item": [
        {
          "name": "GET gold holding",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/gold-holdings"
          }
        }
      ]
    },
    {
      "name": "Trades",
      "item": [
        {
          "name": "Buy gold",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goldAmount\": \"1.5\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/trades/buy"
          }
        },
        {
          "name": "Sell gold",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goldAmount\": \"0.5\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/trades/sell"
          }
        },
        {
          "name": "List trades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades?page=1&limit=20&type=buy",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trades"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "type", "value": "buy", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "type", "value": "deposit", "disabled": true },
                { "key": "from", "value": "2026-01-01", "disabled": true },
                { "key": "to", "value": "2026-12-31", "disabled": true },
                { "key": "userName", "value": "Demo", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Broadcasts",
      "item": [
        {
          "name": "GET active broadcasts",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/broadcasts"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "List all transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "transactions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "userName", "value": "Demo", "disabled": true },
                { "key": "type", "value": "deposit", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List all trades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/trades?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "trades"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Balance adjustment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"100000\",\n  \"reason\": \"Manual correction from Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}/balance-adjustment"
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users/{{userId}}/deactivate"
          }
        },
        {
          "name": "Create broadcast",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Maintenance notice\",\n  \"message\": \"System maintenance tonight 22:00-23:00\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/broadcasts"
          }
        }
      ]
    }
  ]
}
